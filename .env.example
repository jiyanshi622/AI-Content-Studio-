# Environment Configuration for AI Content Studio

# Google Gemini API (Server-side)
GEMINI_API_KEY=

# Server Configuration
PORT=3000

# Cloud SQL / PostgreSQL (Optional - In-memory mock used if not configured)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Firebase Client Configuration (Optional - extracted from firebase-applet-config.json)
FIREBASE_API_KEY=
